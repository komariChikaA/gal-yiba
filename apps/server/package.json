{
  "name": "@gal-yiba/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-static.mjs",
    "db:migrate": "tsx src/cli/migrate.ts",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "sync:vndb": "tsx src/cli/sync-catalog.ts vndb",
    "sync:bangumi": "tsx src/cli/sync-catalog.ts bangumi",
    "mappings:list": "tsx src/cli/review-mappings.ts list",
    "mappings:rebuild": "tsx src/cli/review-mappings.ts rebuild",
    "mappings:approve": "tsx src/cli/review-mappings.ts approve",
    "mappings:reject": "tsx src/cli/review-mappings.ts reject",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@gal-yiba/data": "workspace:*",
    "@gal-yiba/shared": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "socket.io": "^4.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "pg-mem": "^3.0.5",
    "tsx": "^4.20.5"
  }
}
