NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://gal_yiba:gal_yiba@localhost:5432/gal_yiba
REDIS_URL=redis://localhost:6379
VNDB_API_BASE=https://api.vndb.org/kana
BANGUMI_API_BASE=https://api.bangumi.tv
# Bangumi requires an identifiable User-Agent. Replace the contact URL before deployment.
BANGUMI_USER_AGENT=GalYiBa/0.1.0 (https://github.com/OWNER/REPO)
# 未配置此 token �?api.bgm.tv 会过�?nsfw/限制级条目，sync:bangumi-backfill 召回率将显著低于 500 目标
# 获取：https://bgm.tv/oauth 创建应用后取 access_token；回填示例：BANGUMI_ACCESS_TOKEN=xxx pnpm --filter @gal-yiba/server sync:bangumi-backfill --limit=1000 --verify-threshold=70 --with-network
BANGUMI_ACCESS_TOKEN=
# 可选：通用搜索对齐（需自建或第三方搜索代理），用于 NetworkMappingAligner
# WEB_SEARCH_ENABLED=true
# WEB_SEARCH_API_URL=https://your-search-proxy.example/search
# WEB_SEARCH_API_KEY=

